<?xml version="1.0" encoding="UTF-8"?>
<!--
  product.wxs — AttackLens Agent WiX v4 MSI product definition.

  Build via build_msi.ps1 (which harvests the Python source tree first):
    .\build_msi.ps1 -Version "2.0.0"

  Silent install:
    msiexec /i attacklens-agent-2.0.0-x64.msi /qn /l*v install.log ^
        MANAGER_URL="http://34.224.174.38:8080" ^
        AGENT_NAME="WORKSTATION-01"

  Silent uninstall:
    msiexec /x attacklens-agent-2.0.0-x64.msi /qn

  Variables (passed via wix build -d VarName=Value):
    Version       — semantic version string  (e.g. 2.0.0)
    BuildBinDir   — path to build\bin\  (run_agent.py, run_watchdog.py)
    ScriptsDir    — path to installer\  (scripts deployed to scripts\)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package
    Name="AttackLens Agent"
    Manufacturer="AttackLens"
    Version="$(var.Version)"
    UpgradeCode="{8F4A1C2E-9D3B-4E7F-A5C6-2B8D1E3F7A90}"
    Language="1033"
    Codepage="1252"
    InstallerVersion="500"
    Compressed="yes"
    Scope="perMachine">

    <SummaryInformation
      Keywords="AttackLens agent endpoint security telemetry"
      Description="AttackLens Endpoint Agent — encrypted telemetry for Windows"
      Manufacturer="AttackLens" />

    <!-- Stop old version, replace files, start new version -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of AttackLens Agent is already installed."
      AllowSameVersionUpgrades="yes"
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- ================================================================
         MSI Properties (set via msiexec PROP=VALUE)
         ================================================================ -->

    <!-- Manager connectivity -->
    <Property Id="MANAGER_URL"     Secure="yes" />
    <Property Id="ENROLL_TOKEN"    Secure="yes" />
    <Property Id="MANAGER_API_KEY" Secure="yes" />
    <Property Id="SPKI_PIN"        Secure="yes" />
    <Property Id="TLS_VERIFY"      Secure="yes" Value="true" />

    <!-- Identity -->
    <Property Id="AGENT_ID"   Secure="yes" />
    <Property Id="AGENT_NAME" Secure="yes" />

    <!-- PowerShell path for custom actions -->
    <Property Id="PS_EXE" Value="[SystemFolder]WindowsPowerShell\v1.0\powershell.exe" />

    <!-- ================================================================
         Directory tree
           C:\Program Files\AttackLens\
             bin\         — run_agent.py, run_watchdog.py
             scripts\     — management scripts (deployed to PATH via env)
             src\         — Python source (harvested SourceGroup)
           C:\ProgramData\AttackLens\
             logs\
             security\    — SYSTEM + Admins only
             spool\
             data\
         ================================================================ -->

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="AttackLens">
        <Directory Id="BINDIR"     Name="bin" />
        <Directory Id="SCRIPTSDIR" Name="scripts" />
        <Directory Id="SRCDIR"     Name="src" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATADIR" Name="AttackLens">
        <Directory Id="LOGDIR"      Name="logs" />
        <Directory Id="SECURITYDIR" Name="security" />
        <Directory Id="SPOOLDIR"    Name="spool" />
        <Directory Id="SUBDATADIR"  Name="data" />
      </Directory>
    </StandardDirectory>

    <!-- ================================================================
         Components
         ================================================================ -->

    <!-- Bootstrap launchers (generated by build_msi.ps1) -->
    <Component Id="CmpRunAgent" Directory="BINDIR"
               Guid="{8F4A1C2E-9D3B-0001-A5C6-000000000001}">
      <File Id="RunAgentPy"
            Name="run_agent.py"
            Source="$(var.BuildBinDir)\run_agent.py"
            KeyPath="yes" />
    </Component>

    <Component Id="CmpRunWatchdog" Directory="BINDIR"
               Guid="{8F4A1C2E-9D3B-0001-A5C6-000000000002}">
      <File Id="RunWatchdogPy"
            Name="run_watchdog.py"
            Source="$(var.BuildBinDir)\run_watchdog.py"
            KeyPath="yes" />
    </Component>

    <!-- generate_config.ps1 — called by CA_GenerateConfig -->
    <Component Id="CmpGenerateConfig" Directory="SCRIPTSDIR"
               Guid="{8F4A1C2E-9D3B-0002-A5C6-000000000001}">
      <File Id="GenerateConfigPs1"
            Name="generate_config.ps1"
            Source="$(var.ScriptsDir)\generate_config.ps1"
            KeyPath="yes" />
    </Component>

    <!-- setup_services.ps1 — called by CA_SetupServices / CA_TeardownServices -->
    <Component Id="CmpSetupServices" Directory="SCRIPTSDIR"
               Guid="{8F4A1C2E-9D3B-0002-A5C6-000000000002}">
      <File Id="SetupServicesPs1"
            Name="setup_services.ps1"
            Source="$(var.ScriptsDir)\setup_services.ps1"
            KeyPath="yes" />
    </Component>

    <!-- attacklens-service.ps1 (operator CLI) -->
    <Component Id="CmpServiceCli" Directory="SCRIPTSDIR"
               Guid="{8F4A1C2E-9D3B-0002-A5C6-000000000003}">
      <File Id="AttackLensServicePs1"
            Name="attacklens-service.ps1"
            Source="$(var.ScriptsDir)\attacklens-service.ps1"
            KeyPath="yes" />
    </Component>

    <!-- attacklens-service.cmd (CMD shim) -->
    <Component Id="CmpServiceCmd" Directory="SCRIPTSDIR"
               Guid="{8F4A1C2E-9D3B-0002-A5C6-000000000004}">
      <File Id="AttackLensServiceCmd"
            Name="attacklens-service.cmd"
            Source="$(var.ScriptsDir)\attacklens-service.cmd"
            KeyPath="yes" />
    </Component>

    <!-- ProgramData directories with ACLs -->
    <Component Id="CmpDataDir" Directory="DATADIR"
               Guid="{8F4A1C2E-9D3B-0003-A5C6-000000000001}">
      <CreateFolder Directory="DATADIR">
        <util:PermissionEx User="SYSTEM"        GenericAll="yes" />
        <util:PermissionEx User="Administrators" GenericAll="yes" />
      </CreateFolder>
      <RegistryValue Root="HKLM" Key="SOFTWARE\AttackLens\Agent"
        Name="DataDirMarker" Value="1" Type="integer" KeyPath="yes" />
    </Component>

    <Component Id="CmpLogDir" Directory="LOGDIR"
               Guid="{8F4A1C2E-9D3B-0003-A5C6-000000000002}">
      <CreateFolder />
      <RemoveFolder Id="RemoveLogDir" Directory="LOGDIR" On="uninstall" />
    </Component>

    <Component Id="CmpSecurityDir" Directory="SECURITYDIR"
               Guid="{8F4A1C2E-9D3B-0003-A5C6-000000000003}">
      <CreateFolder Directory="SECURITYDIR">
        <util:PermissionEx User="SYSTEM"        GenericAll="yes" />
        <util:PermissionEx User="Administrators" GenericAll="yes" />
      </CreateFolder>
      <RemoveFolder Id="RemoveSecurityDir" Directory="SECURITYDIR" On="uninstall" />
    </Component>

    <Component Id="CmpSpoolDir" Directory="SPOOLDIR"
               Guid="{8F4A1C2E-9D3B-0003-A5C6-000000000004}">
      <CreateFolder />
      <RemoveFolder Id="RemoveSpoolDir" Directory="SPOOLDIR" On="uninstall" />
    </Component>

    <Component Id="CmpSubDataDir" Directory="SUBDATADIR"
               Guid="{8F4A1C2E-9D3B-0003-A5C6-000000000005}">
      <CreateFolder />
      <RemoveFolder Id="RemoveSubDataDir" Directory="SUBDATADIR" On="uninstall" />
    </Component>

    <!-- Registry: install paths, version, Python path (written by CA_SetupServices) -->
    <Component Id="CmpRegistry" Directory="INSTALLDIR"
               Guid="{8F4A1C2E-9D3B-0004-A5C6-000000000001}">
      <RegistryValue Root="HKLM" Key="SOFTWARE\AttackLens\Agent"
        Name="InstallDir" Value="[INSTALLDIR]" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\AttackLens\Agent"
        Name="Version"    Value="$(var.Version)" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\AttackLens\Agent"
        Name="ConfigPath" Value="[DATADIR]agent.toml" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\AttackLens\Agent"
        Name="BinDir"     Value="[BINDIR]" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\AttackLens\Agent"
        Name="DataDir"    Value="[DATADIR]" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\AttackLens\Agent"
        Name="ScriptsDir" Value="[SCRIPTSDIR]" Type="string" />
    </Component>

    <!-- Windows Event Log source -->
    <Component Id="CmpEventLog" Directory="INSTALLDIR"
               Guid="{8F4A1C2E-9D3B-0005-A5C6-000000000001}">
      <util:EventSource
        Log="Application"
        Name="AttackLensAgent"
        EventMessageFile="[SystemFolder]EventCreate.exe" />
    </Component>

    <!-- PATH: add scripts\ to system PATH so attacklens-service.cmd is available -->
    <Component Id="CmpPath" Directory="INSTALLDIR"
               Guid="{8F4A1C2E-9D3B-0006-A5C6-000000000001}">
      <RegistryValue Root="HKLM" Key="SOFTWARE\AttackLens\Agent"
        Name="PathMarker" Value="1" Type="integer" KeyPath="yes" />
      <Environment Id="EnvPath"
        Name="PATH"
        Value="[SCRIPTSDIR]"
        Permanent="no"
        Part="last"
        Action="set"
        System="yes" />
    </Component>

    <!-- ================================================================
         Feature
         ================================================================ -->
    <Feature Id="FeatureComplete" Title="AttackLens Agent" Level="1"
             AllowAdvertise="no" ConfigurableDirectory="INSTALLDIR">
      <ComponentGroupRef Id="SourceGroup" />
      <ComponentRef Id="CmpRunAgent" />
      <ComponentRef Id="CmpRunWatchdog" />
      <ComponentRef Id="CmpGenerateConfig" />
      <ComponentRef Id="CmpSetupServices" />
      <ComponentRef Id="CmpServiceCli" />
      <ComponentRef Id="CmpServiceCmd" />
      <ComponentRef Id="CmpDataDir" />
      <ComponentRef Id="CmpLogDir" />
      <ComponentRef Id="CmpSecurityDir" />
      <ComponentRef Id="CmpSpoolDir" />
      <ComponentRef Id="CmpSubDataDir" />
      <ComponentRef Id="CmpRegistry" />
      <ComponentRef Id="CmpEventLog" />
      <ComponentRef Id="CmpPath" />
    </Feature>

    <!-- ================================================================
         Custom Actions

         CA_GenerateConfig_Deferred — writes agent.toml after files land.
         CA_SetupServices_Deferred  — finds python, installs deps, creates
                                      AttackLensAgent + AttackLensWatchdog
                                      Windows Services.
         CA_TeardownServices_Deferred — stops/removes services on uninstall.
         CA_RemoveData_Deferred      — removes ProgramData on full uninstall.
         ================================================================ -->

    <CustomAction Id="CA_GenerateConfig_Deferred"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      Property="PS_EXE"
      ExeCommand="-NonInteractive -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLDIR]scripts\generate_config.ps1&quot; -InstallDir &quot;[INSTALLDIR]&quot; -DataDir &quot;[DATADIR]&quot; -ManagerUrl &quot;[MANAGER_URL]&quot; -TlsVerify &quot;[TLS_VERIFY]&quot; -EnrollToken &quot;[ENROLL_TOKEN]&quot; -ManagerApiKey &quot;[MANAGER_API_KEY]&quot; -SpkiPin &quot;[SPKI_PIN]&quot; -AgentId &quot;[AGENT_ID]&quot; -AgentName &quot;[AGENT_NAME]&quot;" />

    <CustomAction Id="CA_SetupServices_Deferred"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      Property="PS_EXE"
      ExeCommand="-NonInteractive -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLDIR]scripts\setup_services.ps1&quot; -Action Install -InstallDir &quot;[INSTALLDIR]&quot; -DataDir &quot;[DATADIR]&quot;" />

    <CustomAction Id="CA_TeardownServices_Deferred"
      Execute="deferred"
      Impersonate="no"
      Return="ignore"
      Property="PS_EXE"
      ExeCommand="-NonInteractive -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLDIR]scripts\setup_services.ps1&quot; -Action Uninstall -InstallDir &quot;[INSTALLDIR]&quot; -DataDir &quot;[DATADIR]&quot;" />

    <CustomAction Id="CA_RemoveData_Deferred"
      Execute="deferred"
      Impersonate="no"
      Return="ignore"
      Property="PS_EXE"
      ExeCommand="-NonInteractive -NoProfile -ExecutionPolicy Bypass -Command &quot;Remove-Item -Path '[DATADIR]' -Recurse -Force -ErrorAction SilentlyContinue&quot;" />

    <!-- ================================================================
         Execute sequence
         ================================================================ -->
    <InstallExecuteSequence>
      <!-- Generate config after files are installed -->
      <Custom Action="CA_GenerateConfig_Deferred"
              After="InstallFiles"
              Condition="NOT Installed OR REINSTALL" />

      <!-- Register services and install Python deps after config is ready -->
      <Custom Action="CA_SetupServices_Deferred"
              After="CA_GenerateConfig_Deferred"
              Condition="NOT Installed OR REINSTALL" />

      <!-- Stop and remove services before files are removed -->
      <Custom Action="CA_TeardownServices_Deferred"
              Before="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot;" />

      <!-- Remove runtime data on full uninstall -->
      <Custom Action="CA_RemoveData_Deferred"
              After="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>

  </Package>
</Wix>
